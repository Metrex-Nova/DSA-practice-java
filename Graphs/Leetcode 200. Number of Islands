This code counts the number of islands in a 2D binary grid using BFS (Breadth-First Search). An island is a group of adjacent '1' cells (land) connected horizontally or vertically, surrounded by '0' (water). The algorithm iterates through every cell; when it finds an unvisited '1', it increments the island count, marks it visited, and starts a BFS that explores all connected land cells (up, down, left, right), adding them to the queue and marking them visited. Each BFS completes when all connected '1' cells have been visited, and the search continues for the next unvisited land cell. Finally, the total number of islands is returned.



class Solution {
    public int numIslands(char[][] grid) {
        if (grid == null || grid.length == 0) return 0;

        int[][] dir = {{0,1}, {0,-1}, {1,0}, {-1,0}};
        int n = grid.length;
        int m = grid[0].length;
        int noOfIslands = 0;
        boolean[][] visited = new boolean[n][m];
        Queue<int[]> queue = new LinkedList<>();

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (grid[i][j] == '0') continue;
                if (visited[i][j] == false) {
                    visited[i][j] = true;
                    noOfIslands++;
                    queue.offer(new int[]{i, j});

                    while (!queue.isEmpty()) {
                        int[] curr = queue.poll();
                        int r = curr[0];
                        int c = curr[1];
                        for (int[] d : dir) {
                            int nr = r + d[0];
                            int nc = c + d[1];
                            if (nr >= 0 && nr < n && nc >= 0 && nc < m
                                && grid[nr][nc] == '1' && visited[nr][nc] == false) {
                                visited[nr][nc] = true;
                                queue.offer(new int[]{nr, nc});
                            }
                        }
                    }
                }
            }
        }
        return noOfIslands;
    }
}
