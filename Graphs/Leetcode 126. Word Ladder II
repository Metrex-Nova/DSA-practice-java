This code solves LeetCode 126: "Word Ladder II", which finds all shortest transformation sequences from beginWord to endWord where each step changes one letter and every intermediate word must exist in wordList. It uses a BFS combined with DFS backtracking. The BFS phase builds a DAG (parent map) layer by layer from beginWord to endWord using a two-set approach (current and next) to track levels, removing visited words from wordSet to prevent revisiting. For each word, it generates all one-letter variations; if a variation exists in wordSet, it's added to next and recorded as a child of the current word in the parents map. If endWord is reached, found is set to true. After BFS completes, if endWord is found, DFS backtracking is used to reconstruct all paths from endWord back to beginWord using the parents map, reversing each path before adding to the result.

import java.util.*;

class Solution {
    public List<List<String>> findLadders(String beginWord, String endWord, List<String> wordList) {
        List<List<String>> result = new ArrayList<>();
        Set<String> wordSet = new HashSet<>(wordList);
        if (!wordSet.contains(endWord)) return result;

        Map<String, List<String>> parents = new HashMap<>();
        Set<String> current = new HashSet<>();
        Set<String> next = new HashSet<>();
        current.add(beginWord);
        wordSet.remove(beginWord);
        boolean found = false;

        while (!current.isEmpty() && !found) {
            for (String word : current) wordSet.remove(word);
            next.clear();

            for (String word : current) {
                char[] chars = word.toCharArray();
                for (int i = 0; i < chars.length; i++) {
                    char original = chars[i];
                    for (char c = 'a'; c <= 'z'; c++) {
                        if (c == original) continue;
                        chars[i] = c;                    
                        String newWord = new String(chars);
                        if (wordSet.contains(newWord)) {
                            next.add(newWord);
                            if (!parents.containsKey(newWord)) {
                                parents.put(newWord, new ArrayList<>());
                            }
                            parents.get(newWord).add(word);
                            if (newWord.equals(endWord)) found = true;
                        }
                    }
                    chars[i] = original;               
                }
            }

            Set<String> temp = current;
            current = next;
            next = temp;
        }

        if (found) {
            List<String> path = new LinkedList<>();
            path.add(endWord);
            backtrack(endWord, beginWord, parents, path, result);
        }
        return result;
    } 

    private void backtrack(String word, String beginWord, Map<String, List<String>> parents,
                            List<String> path, List<List<String>> result) {
        if (word.equals(beginWord)) {
            List<String> temp = new ArrayList<>(path);
            Collections.reverse(temp);
            result.add(temp);
            return;
        }
        if (!parents.containsKey(word)) return;
        for (String parent : parents.get(word)) {
            path.add(parent);
            backtrack(parent, beginWord, parents, path, result);
            path.remove(path.size() - 1);
        }
    }
}
